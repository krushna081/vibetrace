{
  "manifest_version": 3,
  "name": "VibeTrace — Website Forensics",
  "short_name": "VibeTrace",
  "version": "0.1.0",
  "description": "Evidence-first website forensics for AI-era builds. Analyze the current tab without exposing form values, cookies or history.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Analyze this page with VibeTrace",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "commands": {
    "analyze-current-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Analyze the active tab with VibeTrace"
    }
  },
  "host_permissions": ["http://localhost:8787/*", "http://127.0.0.1:8787/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
