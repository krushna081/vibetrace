{
  "name": "@vibetrace/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome Manifest V3 extension for analyzing the active tab with the VibeTrace API.",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "dev": "vite",
    "build": "pnpm icons && tsc --noEmit && vite build && vite build --mode content",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vibetrace/api-client": "workspace:*",
    "@vibetrace/design-system": "workspace:*",
    "@vibetrace/shared-types": "workspace:*",
    "lucide-react": "^0.577.0",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  }
}
