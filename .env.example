# -----------------------------------------------------------------------------
# VibeTrace environment configuration
# Copy to .env for local development. Never commit real secrets.
# -----------------------------------------------------------------------------

NODE_ENV=development
HOST=0.0.0.0
PORT=8787
PUBLIC_API_URL=http://localhost:8787
WEB_BASE_URL=http://localhost:5173
# Comma separated. `chrome-extension://*` origins are always allowed for the
# public, credential-free API; add your deployed website origin here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info

# --- Scan limits and safety -------------------------------------------------
SCAN_TIMEOUT_MS=45000
MAX_CONCURRENT_SCANS=2
SCAN_MAX_QUEUE=50
SCAN_MAX_HTML_BYTES=3145728
SCAN_MAX_REDIRECTS=5
SCAN_ALLOWED_PORTS=80,443
SCAN_ASSET_PROBES=true
SCAN_MAX_ASSET_PROBES=4
SCAN_ASSET_MAX_BYTES=524288
SCAN_USER_AGENT=VibeTraceBot/0.1 (+https://github.com/your-org/vibetrace)
SCAN_HISTORY_LIMIT=200
SCAN_RETENTION_HOURS=24
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
SCAN_CREATE_RATE_LIMIT_MAX=10

# --- Persistence ------------------------------------------------------------
# memory is the default zero-dependency local mode. Use prisma for PostgreSQL.
STORAGE_DRIVER=memory
DATABASE_URL=postgresql://vibetrace:vibetrace@localhost:5432/vibetrace?schema=public

# --- Optional AI explanation adapter ---------------------------------------
# disabled | ollama | openai-compatible
# Website content is NEVER sent to a provider unless this is configured AND a
# user explicitly requests an explanation with consent.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- Frontend / extension (Vite) -------------------------------------------
VITE_API_BASE_URL=http://localhost:8787
VITE_WEB_BASE_URL=http://localhost:5173
